---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DEMO_COUPON_CODE } from '../../lib/store';
---
<BaseLayout title="Checkout demo | Archity Ecommerce" description="Formulario frontend validado para checkout simulado.">
  <section class="hero">
    <h1>Checkout simulado</h1>
    <p class="muted">Completa tus datos para generar una confirmación de pedido simulada.</p>
    <div class="banner">No existe backend: no se procesan pagos reales ni se crean órdenes en servidores.</div>
  </section>

  <section class="checkout-grid">
    <form id="checkoutForm" class="panel form-grid" novalidate>
      <label>Nombre completo <input id="fullName" required autocomplete="name" /></label>
      <label>Email <input id="email" type="email" required autocomplete="email" /></label>
      <label>Teléfono <input id="phone" required inputmode="tel" minlength="8" /></label>
      <label>Dirección <input id="address" required autocomplete="street-address" /></label>
      <label>Ciudad <input id="city" required autocomplete="address-level2" /></label>

      <label>
        Entrega
        <select id="delivery" required>
          <option value="standard">Estándar (2-5 días)</option>
          <option value="express">Express (24h)</option>
        </select>
      </label>

      <label>
        Pago simulado
        <select id="payment" required>
          <option value="card">Tarjeta (simulado)</option>
          <option value="transfer">Transferencia (simulado)</option>
          <option value="cash">Contraentrega (simulado)</option>
        </select>
      </label>

      <label>
        Cupón demo
        <input id="couponInput" placeholder={`Prueba ${DEMO_COUPON_CODE}`} />
      </label>

      <button class="button-primary" type="submit">Confirmar pedido simulado</button>
      <p id="formError" class="notice" style="display:none;"></p>
    </form>

    <aside class="panel">
      <h2 style="margin-top:0;">Resumen del pedido</h2>
      <div id="checkoutSummary" class="summary"></div>
    </aside>
  </section>
</BaseLayout>

<script>
  import { products } from '../../data/products';
  import { getState, getTotals, applyCoupon, clearCart } from '../../lib/store';

  const summaryNode = document.querySelector<HTMLDivElement>('#checkoutSummary');
  const form = document.querySelector<HTMLFormElement>('#checkoutForm');
  const errorNode = document.querySelector<HTMLParagraphElement>('#formError');

  const renderSummary = () => {
    const state = getState();
    const totals = getTotals(products);

    if (!summaryNode) return;

    if (state.cart.length === 0) {
      summaryNode.innerHTML = '<p class="muted">Tu carrito está vacío. Agrega productos desde el catálogo.</p>';
      return;
    }

    summaryNode.innerHTML = `
      ${state.cart
        .map((item) => {
          const product = products.find((entry) => entry.id === item.productId);
          if (!product) return '';
          return `<div class="row"><span>${product.name} × ${item.quantity}</span><span>$${(product.price * item.quantity).toFixed(2)}</span></div>`;
        })
        .join('')}
      <hr style="border:none;border-top:1px solid #e6e8ee;" />
      <div class="row"><span>Subtotal</span><strong>$${totals.subtotal.toFixed(2)}</strong></div>
      <div class="row"><span>Envío</span><strong>$${totals.shipping.toFixed(2)}</strong></div>
      <div class="row"><span>Descuento</span><strong>-$${totals.discount.toFixed(2)}</strong></div>
      <div class="row"><span>Total</span><strong>$${totals.total.toFixed(2)}</strong></div>
    `;
  };

  const getInput = (selector: string) => document.querySelector<HTMLInputElement | HTMLSelectElement>(selector);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const cart = getState().cart;
    if (cart.length === 0) {
      if (errorNode) {
        errorNode.style.display = 'block';
        errorNode.textContent = 'No puedes finalizar checkout con el carrito vacío.';
      }
      return;
    }

    const values = {
      fullName: getInput('#fullName')?.value.trim() || '',
      email: getInput('#email')?.value.trim() || '',
      phone: getInput('#phone')?.value.trim() || '',
      address: getInput('#address')?.value.trim() || '',
      city: getInput('#city')?.value.trim() || '',
      delivery: getInput('#delivery')?.value || 'standard',
      payment: getInput('#payment')?.value || 'card'
    };

    if (Object.values(values).some((value) => !String(value).trim())) {
      if (errorNode) {
        errorNode.style.display = 'block';
        errorNode.textContent = 'Completa todos los campos requeridos para continuar.';
      }
      return;
    }

    const couponValue = getInput('#couponInput')?.value || '';
    if (couponValue.trim()) applyCoupon(couponValue);

    const totals = getTotals(products);
    const orderPayload = {
      id: `SIM-${Date.now()}`,
      ...values,
      totals,
      cart,
      createdAt: new Date().toISOString()
    };

    if (typeof window !== 'undefined') {
      window.localStorage.setItem('archity-last-order', JSON.stringify(orderPayload));
    }

    clearCart();
    window.location.href = '/checkout/confirmacion';
  });

  renderSummary();
  window.addEventListener('app:state-changed', renderSummary as EventListener);
</script>
